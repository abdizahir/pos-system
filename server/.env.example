# ------------------------------------------------------------
# Server settings — one set per shop.
# Copy to .env for local development; on Railway add these as
# variables on the shop's server service.
# ------------------------------------------------------------

# This shop's PostgreSQL database (on Railway: reference the shop's
# Postgres service, e.g. ${{Postgres.DATABASE_URL}})
DATABASE_URL="postgresql://user:password@localhost:5432/pos_db"

# Long random secret for login tokens. Use a DIFFERENT value for every
# shop, e.g. the output of:  openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# The shop's frontend address(es), comma-separated
CORS_ORIGIN="http://localhost:5173"

# Shown on the login page, invoices and PDF reports
SHOP_NAME="My Mini Market"
SHOP_ADDRESS="Main Street, Jigjiga"
SHOP_PHONE="0900000000"
SHOP_TIN=""

# Set by Railway automatically; 3000 when running locally
# PORT=3000

# Number of proxies in front of the server (Railway: 1, local: 0 is fine)
# TRUST_PROXY=1

# Largest discount a cashier can give, as a percent of the sale
# (the manager has no limit). Default 10.
# MAX_CASHIER_DISCOUNT_PERCENT=10
