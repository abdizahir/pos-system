generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// USER
// ============================================================

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String
  isActive     Boolean  @default(true) @map("is_active")
  // Logins issued before this time are refused (set on sign-out)
  tokensValidAfter DateTime? @map("tokens_valid_after")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sales            Sale[]
  stockBatches     StockBatch[]
  stockMovements   StockMovement[]
  purchases        Purchase[]
  expenses         Expense[]
  incomes          Income[]
  salaryPayments   SalaryPayment[]
  ownerWithdrawals OwnerWithdrawal[]
  vatPayments      VatPayment[]
  moneyTransfers   MoneyTransfer[]

  @@map("users")
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

// ============================================================
// UNIT
// ============================================================

model Unit {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("units")
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id            Int      @id @default(autoincrement())
  productName   String   @map("product_name")
  sku           String   @unique @default(dbgenerated("('PT'::text || lpad((nextval('product_sku_seq'::regclass))::text, 3, '0'::text))"))
  barcode       String?  @unique
  categoryId    Int      @map("category_id")
  unitId        Int      @map("unit_id")
  sellingPrice  Decimal  @map("selling_price") @db.Decimal(10, 2)
  lowStockLimit Int      @default(0) @map("low_stock_limit")
  vat           Decimal  @default(0) @db.Decimal(5, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  stockQuantity Int      @default(0) @map("stock_quantity")

  category Category @relation(fields: [categoryId], references: [id])
  unit     Unit     @relation(fields: [unitId], references: [id])

  saleItems      SaleItem[]
  returnItems    SaleReturnItem[]
  stockBatches   StockBatch[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]

  @@index([categoryId])
  @@index([unitId])
  @@map("products")
}

// ============================================================
// Customer
// ============================================================

model Customer {
  id        Int      @id @default(autoincrement())
  fname     String
  lname     String
  phone     String   @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@map("customers")
}

// ============================================================
// EMPLOYEE
// ============================================================

enum Gender {
  MALE
  FEMALE
}

model Employee {
  id         Int     @id @default(autoincrement())
  nationalId String  @unique @map("national_id")
  fname      String
  lname      String
  gender     Gender
  email      String? @unique
  address    String?
  salary     Decimal @db.Decimal(12, 2)

  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  salaryPayments SalaryPayment[]

  @@index([lname])
  @@map("employees")
}

// One salary payment per employee per month
model SalaryPayment {
  id            Int           @id @default(autoincrement())
  employeeId    Int           @map("employee_id")
  period        String // "YYYY-MM"
  amount        Decimal       @db.Decimal(12, 2)
  paidAt        DateTime      @map("paid_at")
  paymentMethod PaymentMethod @map("payment_method")
  accountId     Int?          @map("account_id")
  reference     String?
  notes         String?

  userId Int @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id])
  account  Account? @relation(fields: [accountId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  journalEntries JournalEntry[]

  @@unique([employeeId, period])
  @@index([period])
  @@index([accountId])
  @@map("salary_payments")
}

// ============================================================
// OWNER
// ============================================================

model Owner {
  id         Int     @id @default(autoincrement())
  nationalId String  @unique @map("national_id")
  fname      String
  lname      String
  gender     Gender
  email      String? @unique
  address    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  withdrawals OwnerWithdrawal[]

  @@index([lname])
  @@map("owners")
}

// Money the owner takes out of the business (drawings)
model OwnerWithdrawal {
  id            Int           @id @default(autoincrement())
  ownerId       Int           @map("owner_id")
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime
  paymentMethod PaymentMethod @map("payment_method")
  accountId     Int?          @map("account_id")
  reference     String?
  notes         String?

  userId Int @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner   Owner    @relation(fields: [ownerId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  journalEntries JournalEntry[]

  @@index([ownerId])
  @@index([date])
  @@index([accountId])
  @@map("owner_withdrawals")
}

// ============================================================
// VAT PAYMENTS
// ============================================================

enum TaxAuthority {
  SOMALI_REGIONAL_STATE_REVENUE_BUREAU
  JIGJIGA_CITY_REVENUE_BUREAU
}

// VAT paid to the tax authority. Reduces 2100 VAT Payable.
model VatPayment {
  id            Int           @id @default(autoincrement())
  authority     TaxAuthority
  amount        Decimal       @db.Decimal(12, 2)
  date          DateTime
  paymentMethod PaymentMethod @map("payment_method")
  accountId     Int?          @map("account_id")
  reference     String?
  notes         String?

  userId Int @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account? @relation(fields: [accountId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  journalEntries JournalEntry[]

  @@index([date])
  @@index([authority])
  @@map("vat_payments")
}

// ============================================================
// SUPPLIER
// ============================================================

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchases    Purchase[]
  stockBatches StockBatch[]

  @@index([name])
  @@map("suppliers")
}

// ============================================================
// PURCHASE
// ============================================================

model Purchase {
  id         Int    @id @default(autoincrement())
  reference  String @unique
  // Optional: a purchase can be recorded without a supplier
  supplierId Int?   @map("supplier_id")
  userId     Int    @map("user_id")

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(10, 2)
  dueAmount  Decimal @default(0) @map("due_amount") @db.Decimal(10, 2)

  // Payment information
  paymentMethod PaymentMethod? @map("payment_method")
  accountId     Int?           @map("account_id")

  status PurchaseStatus @default(COMPLETED)

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  user     User      @relation(fields: [userId], references: [id])
  account  Account?  @relation(fields: [accountId], references: [id])

  items        PurchaseItem[]
  stockBatches StockBatch[]

  journalEntries JournalEntry[]

  @@index([supplierId])
  @@index([userId])
  @@index([accountId])
  @@index([createdAt])
  @@index([status])
  @@map("purchases")
}

// ============================================================
// PURCHASE ITEM
// ============================================================

model PurchaseItem {
  id           Int  @id @default(autoincrement())
  purchaseId   Int  @map("purchase_id")
  productId    Int  @map("product_id")
  stockBatchId Int? @map("stock_batch_id")

  quantity      Int
  purchasePrice Decimal @map("purchase_price") @db.Decimal(10, 2)
  discount      Decimal @default(0) @db.Decimal(10, 2)
  tax           Decimal @default(0) @db.Decimal(10, 2)
  lineTotal     Decimal @map("line_total") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchase   Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id])
  stockBatch StockBatch? @relation(fields: [stockBatchId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@index([stockBatchId])
  @@map("purchase_items")
}

// ============================================================
// STOCK BATCH
// ============================================================

model StockBatch {
  id         Int  @id @default(autoincrement())
  productId  Int  @map("product_id")
  userId     Int? @map("user_id")
  supplierId Int? @map("supplier_id")
  purchaseId Int? @map("purchase_id")

  quantity      Int
  purchasePrice Decimal   @map("purchase_price") @db.Decimal(10, 2)
  expiryDate    DateTime? @map("expiry_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product  Product   @relation(fields: [productId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  purchase Purchase? @relation(fields: [purchaseId], references: [id])

  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]

  @@index([productId])
  @@index([userId])
  @@index([supplierId])
  @@index([purchaseId])
  @@index([expiryDate])
  @@map("stock_batches")
}

// ============================================================
// STOCK MOVEMENT
// ============================================================

model StockMovement {
  id        Int               @id @default(autoincrement())
  productId Int               @map("product_id")
  userId    Int?              @map("user_id")
  type      StockMovementType
  quantity  Int
  notes     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stockBatchId Int? @map("stock_batch_id")
  saleId       Int? @map("sale_id")

  product    Product     @relation(fields: [productId], references: [id])
  sale       Sale?       @relation(fields: [saleId], references: [id])
  stockBatch StockBatch? @relation(fields: [stockBatchId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([stockBatchId])
  @@index([saleId])
  @@index([userId])
  @@map("stock_movements")
}

// ============================================================
// SALE
// ============================================================

model Sale {
  id            Int    @id @default(autoincrement())
  invoiceNumber String @unique @map("invoice_number")
  userId        Int    @map("user_id")
  customerId    Int?   @map("customer_id")

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  paidAmount   Decimal @default(0) @map("paid_amount") @db.Decimal(10, 2)
  dueAmount    Decimal @default(0) @map("due_amount") @db.Decimal(10, 2)
  changeAmount Decimal @default(0) @map("change_amount") @db.Decimal(10, 2)

  status SaleStatus @default(COMPLETED)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer       Customer?       @relation(fields: [customerId], references: [id])
  payments       Payment[]
  items          SaleItem[]
  returns        SaleReturn[]
  user           User            @relation(fields: [userId], references: [id])
  stockMovements StockMovement[]

  journalEntries JournalEntry[]

  @@index([userId])
  @@index([customerId])
  @@index([invoiceNumber])
  @@index([createdAt])
  @@map("sales")
}

// ============================================================
// SALE ITEM
// ============================================================

model SaleItem {
  id        Int @id @default(autoincrement())
  saleId    Int @map("sale_id")
  productId Int @map("product_id")
  quantity  Int

  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  tax       Decimal @default(0) @db.Decimal(10, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  returnedQuantity Int @default(0) @map("returned_quantity")
  stockBatchId     Int @map("stock_batch_id")

  product     Product          @relation(fields: [productId], references: [id])
  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  stockBatch  StockBatch       @relation(fields: [stockBatchId], references: [id])
  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@index([stockBatchId])
  @@map("sale_items")
}

// ============================================================
// SALE RETURN
// ============================================================

model SaleReturn {
  id     Int @id @default(autoincrement())
  saleId Int @map("sale_id")

  reason String
  notes  String?

  subtotal Decimal @db.Decimal(10, 2)
  tax      Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  // Refund information
  refundMethod PaymentMethod? @map("refund_method")
  accountId    Int?           @map("account_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items   SaleReturnItem[]
  sale    Sale             @relation(fields: [saleId], references: [id])
  account Account?         @relation(fields: [accountId], references: [id])

  journalEntries JournalEntry[]

  @@index([saleId])
  @@index([accountId])
  @@map("sale_returns")
}

// ============================================================
// SALE RETURN ITEM
// ============================================================

model SaleReturnItem {
  id           Int @id @default(autoincrement())
  saleReturnId Int @map("sale_return_id")
  saleItemId   Int @map("sale_item_id")
  productId    Int @map("product_id")

  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(10, 2)

  product    Product    @relation(fields: [productId], references: [id])
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])
  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)

  @@index([saleReturnId])
  @@index([saleItemId])
  @@index([productId])
  @@map("sale_return_items")
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id        Int  @id @default(autoincrement())
  saleId    Int  @map("sale_id")
  accountId Int? @map("account_id")

  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  reference String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id])

  @@index([saleId])
  @@index([accountId])
  @@map("payments")
}

// ============================================================
// EXPENSE
// ============================================================

model Expense {
  id            Int           @id @default(autoincrement())
  title         String
  category      String
  amount        Decimal       @db.Decimal(10, 2)
  date          DateTime
  paymentMethod PaymentMethod @map("payment_method")
  accountId     Int?          @map("account_id")
  reference     String?
  notes         String?

  userId Int @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  journalEntries JournalEntry[]

  @@index([category])
  @@index([date])
  @@index([paymentMethod])
  @@index([accountId])
  @@index([userId])
  @@map("expenses")
}

// ============================================================
// INCOME (money received that is not a sale)
// ============================================================

model Income {
  id            Int           @id @default(autoincrement())
  title         String
  category      String
  amount        Decimal       @db.Decimal(10, 2)
  date          DateTime
  paymentMethod PaymentMethod @map("payment_method")
  accountId     Int?          @map("account_id")
  reference     String?
  notes         String?

  userId Int @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  journalEntries JournalEntry[]

  @@index([category])
  @@index([date])
  @@index([paymentMethod])
  @@index([accountId])
  @@index([userId])
  @@map("incomes")
}

// ============================================================
// ACTUAL BANK / WALLET ACCOUNTS
// ============================================================

model Account {
  id             Int           @id @default(autoincrement())
  bankName       String?
  name           String
  type           AccountType
  number         String        @unique
  // Legacy cache only. Balances are computed from posted journal lines.
  currentBalance Decimal       @default(0) @db.Decimal(14, 2)
  status         AccountStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments          Payment[]
  purchases         Purchase[]
  expenses          Expense[]
  incomes           Income[]
  salaryPayments    SalaryPayment[]
  ownerWithdrawals  OwnerWithdrawal[]
  vatPayments       VatPayment[]
  saleReturns       SaleReturn[]
  outgoingTransfers MoneyTransfer[]   @relation("MoneyTransferFromAccount")
  incomingTransfers MoneyTransfer[]   @relation("MoneyTransferToAccount")
  journalLines      JournalLine[]

  @@index([bankName])
  @@index([name])
  @@index([type])
  @@index([status])
  @@map("accounts")
}

// ============================================================
// MONEY TRANSFER
// ============================================================

model MoneyTransfer {
  id Int @id @default(autoincrement())

  date      DateTime @default(now())
  reference String
  number    String   @unique
  amount    Decimal  @db.Decimal(14, 2)

  fromAccountId Int @map("from_account_id")
  toAccountId   Int @map("to_account_id")
  userId        Int @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fromAccount Account @relation("MoneyTransferFromAccount", fields: [fromAccountId], references: [id])
  toAccount   Account @relation("MoneyTransferToAccount", fields: [toAccountId], references: [id])
  user        User    @relation(fields: [userId], references: [id])

  @@index([date])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([userId])
  @@map("money_transfers")
}

// ============================================================
// CHART OF ACCOUNTS
// ============================================================

model ChartAccount {
  id       Int              @id @default(autoincrement())
  code     String           @unique
  name     String
  type     ChartAccountType
  isActive Boolean          @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  journalLines JournalLine[]

  @@index([type])
  @@index([isActive])
  @@map("chart_accounts")
}

// ============================================================
// JOURNAL ENTRY
// ============================================================

model JournalEntry {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  reference   String?
  description String?

  saleId            Int? @map("sale_id")
  purchaseId        Int? @map("purchase_id")
  expenseId         Int? @map("expense_id")
  incomeId          Int? @map("income_id")
  salaryPaymentId   Int? @map("salary_payment_id")
  ownerWithdrawalId Int? @map("owner_withdrawal_id")
  vatPaymentId      Int? @map("vat_payment_id")
  saleReturnId      Int? @map("sale_return_id")

  sale            Sale?            @relation(fields: [saleId], references: [id])
  purchase        Purchase?        @relation(fields: [purchaseId], references: [id])
  expense         Expense?         @relation(fields: [expenseId], references: [id])
  income          Income?          @relation(fields: [incomeId], references: [id])
  salaryPayment   SalaryPayment?   @relation(fields: [salaryPaymentId], references: [id])
  ownerWithdrawal OwnerWithdrawal? @relation(fields: [ownerWithdrawalId], references: [id])
  vatPayment      VatPayment?      @relation(fields: [vatPaymentId], references: [id])
  saleReturn      SaleReturn?      @relation(fields: [saleReturnId], references: [id])

  lines JournalLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@index([saleId])
  @@index([purchaseId])
  @@index([expenseId])
  @@index([incomeId])
  @@index([salaryPaymentId])
  @@index([ownerWithdrawalId])
  @@index([vatPaymentId])
  @@index([saleReturnId])
  @@map("journal_entries")
}

// ============================================================
// JOURNAL LINE
// ============================================================

model JournalLine {
  id             Int @id @default(autoincrement())
  journalEntryId Int @map("journal_entry_id")
  accountId      Int @map("account_id")

  debit  Decimal @default(0) @db.Decimal(12, 2)
  credit Decimal @default(0) @db.Decimal(12, 2)

  // Bank / wallet / merchant account the money moved through.
  // Set on payment lines (1010/1020/1030); null for cash and non-money lines.
  paymentAccountId Int? @map("payment_account_id")

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        ChartAccount @relation(fields: [accountId], references: [id])
  paymentAccount Account?     @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([paymentAccountId])
  @@map("journal_lines")
}

// ============================================================
// ENUMS
// ============================================================

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  OPENING
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  RETURNED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  BANK
}

enum AccountType {
  BANK
  WALLET
  MERCHANT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum ChartAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}
